{
  "name": "skillforgejs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-runtimes.mjs",
    "prebuild": "node scripts/prepare-runtimes.mjs",
    "content:ids": "node scripts/assign-content-ids.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:migrate": "node scripts/migrate-content-identity.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e-local.mjs",
    "test:db": "node scripts/test-completion-local.mjs && node scripts/test-backup-local.mjs",
    "runtime:prepare": "node scripts/prepare-runtimes.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "csharp:build": "dotnet build tools/csharp-runner -c Release"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "@prisma/client": "^6.17.1",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "16.2.9",
    "playwright": "^1.56.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.3.1",
    "ts-fsrs": "^5.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
