// Skillforge -- local-only, single-learner build.
// Storage is a SQLite file (see DATABASE_URL); there is no auth, no billing,
// and no multi-tenant tables. SQLite via Prisma has no enum or scalar-list
// support, so those columns are strings/JSON validated in src/lib/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The one local learner. Row id is always "local".
model User {
  id         String  @id @default("local")
  name       String  @default("Learner")
  email      String? @unique

  // Personalization captured during onboarding.
  goal        String    @default("crud-dev") // crud-dev | interview | fundamentals
  experience  String    @default("beginner") // beginner | junior | mid
  focusTags   String    @default("[]") // JSON string[] of concept tags that bias the feed
  onboardedAt DateTime?

  reviewStates       ReviewState[]
  attempts           Attempt[]
  progress           Progress?
  completions        LessonCompletion[]
  achievements       UserAchievement[]
  problemSubmissions ProblemSubmission[]
  xpEvents           XpEvent[]
  quests             Quest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  language    String
  topicTags   String   @default("[]") // JSON string[]
  difficulty  String // BEGINNER | INTERMEDIATE | ADVANCED
  order       Int
  outcomes    String   @default("[]") // JSON string[]
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([language, difficulty])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
}

model Lesson {
  id             String             @id @default(cuid())
  moduleId       String
  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  contentBlocks  Json
  knowledgeItems KnowledgeItem[]
  completions    LessonCompletion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([moduleId, order])
}

model KnowledgeItem {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Position within the lesson. Together with `lessonId` this is the stable
  /// identity the seed upserts against, so re-seeding unchanged content keeps
  /// the row id -- and therefore the learner's ReviewState -- intact.
  order        Int
  type         String // MCQ | CODE | CLOZE
  prompt       String
  payload      Json
  conceptTags  String        @default("[]") // JSON string[]
  reviewStates ReviewState[]
  attempts     Attempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId])
}

model ReviewState {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  dueAt           DateTime
  stability       Float         @default(0)
  difficulty      Float         @default(5)
  interval        Int           @default(0)
  lapses          Int           @default(0)
  reps            Int           @default(0)
  lastReviewedAt  DateTime?
  state           String        @default("NEW") // NEW | LEARNING | REVIEW | RELEARNING
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, knowledgeItemId])
  @@index([userId, dueAt])
}

model Attempt {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  response        Json
  correct         Boolean
  recallScore     String // AGAIN | HARD | GOOD | EASY
  durationMs      Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
}

model Progress {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int       @default(0)
  level          Int       @default(1)
  streakCurrent  Int       @default(0)
  streakLongest  Int       @default(0)
  lastActiveDate DateTime?
  streakFreezes  Int       @default(2)
  dailyXpGoal    Int       @default(60)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Append-only XP ledger. Powers the daily goal ring, the activity heatmap and
/// quest progress without recomputing from every other table.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // lesson | review | exercise | quest | achievement
  amount    Int
  day       String // local YYYY-MM-DD, so day rollups stay in the learner timezone
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, day])
  @@index([userId, createdAt])
}

/// One row per quest per local day. Rolled fresh each morning.
model Quest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String // local YYYY-MM-DD
  key         String
  title       String
  target      Int
  progress    Int       @default(0)
  xpReward    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, day, key])
  @@index([userId, day])
}

model LessonCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  icon        String
  tier        String            @default("bronze") // bronze | silver | gold
  xpReward    Int               @default(0)
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, achievementId])
}

model Problem {
  id                String              @id @default(cuid())
  slug              String              @unique
  title             String
  prompt            String
  explanation       Json
  /// Catalog label shown to the learner ("csharp", "react", "typescript"...).
  language          String              @default("javascript")
  /// Which sandbox grades it. A C#-themed problem can still be answered in
  /// TypeScript, so this is derived from the exercise files, not the label.
  runtime           String              @default("javascript")
  difficulty        String // EASY | MEDIUM | HARD
  conceptTags       String              @default("[]") // JSON string[]
  starterCode       String
  functionName      String
  tests             Json
  referenceSolution String
  order             Int                 @default(0)
  submissions       ProblemSubmission[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([language, difficulty])
}

model ProblemSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code       String
  passed     Boolean
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, problemId])
  @@index([problemId, passed])
}
